{
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "module": "esnext",
    "target": "esnext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": true,
    "checkJs": false,
    "types": ["bun-types"]
  },
  "include": [
    "src/**/*",
    "scripts/**/*",
    "tests/**/*",
    "server.mjs",
    "*.js",
    "*.ts"
  ]
}
